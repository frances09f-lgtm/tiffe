<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_cream" />
    <item android:height="400dp" android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/splash_green" />
            <corners android:bottomLeftRadius="56dp" android:bottomRightRadius="56dp" />
        </shape>
    </item>
    <item android:width="186dp" android:height="186dp" android:gravity="top|center_horizontal" android:top="96dp">
        <shape android:shape="oval">
            <solid android:color="@color/splash_cream" />
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="top|center_horizontal" android:top="104dp">
        <bitmap android:src="@drawable/splash_logo" android:gravity="fill" />
    </item>
</layer-list>
